# Shared configuration for the MiniMax-M3 MXFP8 ATOM-vs-vLLM prefill comparison.
# Sourced by every script in this directory. Override via environment.

# --- Fill these in -----------------------------------------------------------
# MXFP8 checkpoint (config.json must contain "quant_method": "mxfp8").
MODEL_PATH="${MODEL_PATH:-/models/MiniMax-M3-MXFP8}"
# Docker images. IMAGE_ATOM must contain atom+aiter; IMAGE_VLLM must contain an
# upstream vLLM new enough to have vllm/models/minimax_m3/ (main >= 2026-06-15).
# The atom-oot image (docker/vllm_release.dockerfile) contains BOTH stacks and
# can be used for both roles.
IMAGE_ATOM="${IMAGE_ATOM:-rocm/atom-dev:latest}"
IMAGE_VLLM="${IMAGE_VLLM:-rocm/atom-dev:vllm-latest}"

# --- Fixed comparison parameters (do NOT diverge between the two stacks) -----
TP="${TP:-4}"
BLOCK_SIZE=128
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=32768
GPU_MEM_UTIL=0.85
HF_OVERRIDES='{"use_index_cache": true, "index_topk_freq": 4}'

# --- Machine-specific overrides (not in git), sourced BEFORE dependent vars --
# On vultr-mi355x: site.env points MODEL_PATH at the shared checkpoint,
# WORK_DIR at the shared home, IMAGE_* at the .sqsh files.
_site="$(dirname "${BASH_SOURCE[0]:-$0}")/site.env"
[ -f "$_site" ] && source "$_site"

# --- Workload: prefill-only --------------------------------------------------
# Single request, INPUT_LEN prompt tokens, max_tokens=1 => exactly one prefill.
INPUT_LEN="${INPUT_LEN:-4096}"
WARMUP_REQUESTS=2          # unprofiled warmups before the profiled request

# --- Output layout -----------------------------------------------------------
WORK_DIR="${WORK_DIR:-$HOME/m3_compare}"
TRACE_DIR_ATOM="$WORK_DIR/traces/atom"
TRACE_DIR_VLLM="$WORK_DIR/traces/vllm"
RESULT_DIR="$WORK_DIR/results"

# --- Ports (uncommon values: node-local port 8000 has had stray listeners) ---
ATOM_PORT="${ATOM_PORT:-8123}"
VLLM_PORT="${VLLM_PORT:-8124}"
